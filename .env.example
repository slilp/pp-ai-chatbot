# LLM — OpenAI-compatible endpoint (llama-swap, LM Studio, vLLM, OpenAI, etc.)
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=llm-key

# Model names (as reported by your LLM server)
ORCHESTRATOR_MODEL=qwen/qwen3-14b
ANALYZER_MODEL=qwen/qwen3-14b

# Optional: separate endpoint for the analyzer sub-agent
# ANALYZER_BASE_URL=http://localhost:1235/v1
# ANALYZER_API_KEY=llm-key

# OpenSearch
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=k8s-logs
OPENSEARCH_USER=
OPENSEARCH_PASS=

# Max log documents sent to the analyzer (default: 150)
MAX_LOG_HITS=150
