# Copy to ../.env and adjust values

# llama-swap proxy (default port matches docker-compose LLM_BASE_URL)
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=llm-key

# Must match model keys in llama-swap/config.yaml
ORCHESTRATOR_MODEL=qwen3-32b
ANALYZER_MODEL=qwen3-14b

# OpenSearch
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=k8s-logs
